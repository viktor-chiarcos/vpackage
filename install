#!/bin/bash

echo "Installation gestartet."
echo `pwd` > ~/vpackage-path.log
if [ -e ~/bin ]
then echo "[VPACKAGE INSTALLER SKRIPT] $HOME/bin exestiert bereits" > ~/vpackage_log
else mkdir ~/bin 
fi
ln -s $PWD/vpackage ~/bin/vpackage 
ln -s vpackage-gui ~/vpackage-gui
echo "HINWEIS: Du darft den Pfad vom Repo nicht verändern!"
