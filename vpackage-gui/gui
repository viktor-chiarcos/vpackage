from tkinter import *
import os
def InstallerButton():
   thetext = text.get('1.0', 'end')
   os.system(f"~/vpackage-gui/term install {thetext}")
def UpdaterButton():
   thetext = text.get('1.0', 'end')
   os.system(f"~/vpackage-gui/term update {thetext}")
