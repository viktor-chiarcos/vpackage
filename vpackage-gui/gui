Fenster = Tk()
os.system("echo $USER@`hostname` > ~/login")
with open("./login","rt") as login:
   login2=login.read()
Fenster.title(f"Vpackage GUI - Das grafische Interface für vpackage")
Fenster.minsize(width=1265 , height=700)#0)
